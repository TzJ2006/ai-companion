{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node ./hooks/gate.mjs",
        "matcher": "Write|StrReplace|Delete|EditNotebook|ApplyPatch",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      { "command": "node ./hooks/record.mjs" }
    ],
    "sessionStart": [
      { "command": "node ./hooks/session.mjs" }
    ]
  }
}
