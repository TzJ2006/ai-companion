{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|apply_patch|Bash|bash|PowerShell|powershell|pwsh|shell|local_shell|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.companion/companion.mjs\" guard --platform=codex",
            "commandWindows": "for /f \"delims=\" %g in ('git rev-parse --show-toplevel 2^>nul ^|^| cd') do @node \"%g/.companion/companion.mjs\" guard --platform=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|apply_patch|Read|read|read_file|readfile|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.companion/companion.mjs\" guard --platform=codex",
            "commandWindows": "for /f \"delims=\" %g in ('git rev-parse --show-toplevel 2^>nul ^|^| cd') do @node \"%g/.companion/companion.mjs\" guard --platform=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.companion/companion.mjs\" guard --platform=codex",
            "commandWindows": "for /f \"delims=\" %g in ('git rev-parse --show-toplevel 2^>nul ^|^| cd') do @node \"%g/.companion/companion.mjs\" guard --platform=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.companion/companion.mjs\" guard --platform=codex",
            "commandWindows": "for /f \"delims=\" %g in ('git rev-parse --show-toplevel 2^>nul ^|^| cd') do @node \"%g/.companion/companion.mjs\" guard --platform=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.companion/companion.mjs\" guard --platform=codex",
            "commandWindows": "for /f \"delims=\" %g in ('git rev-parse --show-toplevel 2^>nul ^|^| cd') do @node \"%g/.companion/companion.mjs\" guard --platform=codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
