# dependencies
node_modules/

# build output (regenerate with `node companion/build.mjs`)
dist/
# ...except the shared base's single-file artifact, which is the SHIPPED thing:
# the installer copies the bundle, not a pointer to this checkout (D34), and a
# fresh clone with no bundle cannot install at all — install.ts stops at
# "先构建产物". Re-including the directory first is required; git never looks
# inside an excluded directory, so a bare `!companion/dist/companion.mjs` after
# `dist/` would do nothing.
!companion/dist/
*.tsbuildinfo

# local runtime state — but keep the test suite tracked

# local-only Claude Code settings
.claude/settings.local.json


# one-off backup snapshots and scratch files (history preserved in git)
archive/
temp_*

# regenerable HTML reports at the repo root (real output goes to .devcompanion/reports/)
/*.html
ideas/graph.html

# >>> AI Dev Companion (managed)
# 3a tests-preserving (aidev init / HistoryStore; installer may replace this block)
.devcompanion/*
!.devcompanion/tests/
# <<< AI Dev Companion

# per-machine install registry (absolute paths)
companion/.installs.json
