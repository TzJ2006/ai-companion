{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/companion.py\" hook prompt",
            "commandWindows": "python \"${PLUGIN_ROOT}\\scripts\\companion.py\" hook prompt",
            "timeout": 5,
            "statusMessage": "Validating Codex Companion approval..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/companion.py\" hook pre",
            "commandWindows": "python \"${PLUGIN_ROOT}\\scripts\\companion.py\" hook pre",
            "timeout": 5,
            "statusMessage": "Checking Codex Companion gates..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/companion.py\" hook post",
            "commandWindows": "python \"${PLUGIN_ROOT}\\scripts\\companion.py\" hook post",
            "timeout": 5,
            "statusMessage": "Recording Codex Companion changes..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/companion.py\" hook stop",
            "commandWindows": "python \"${PLUGIN_ROOT}\\scripts\\companion.py\" hook stop",
            "timeout": 5,
            "statusMessage": "Checking Codex Companion completion..."
          }
        ]
      }
    ]
  }
}
