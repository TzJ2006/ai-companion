{
  "name": "ai-dev-companion",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "dashboard": "tsx packages/dashboard/src/server.ts",
    "dashboard:start": "tsx packages/dashboard/src/cli.ts start",
    "dashboard:stop": "tsx packages/dashboard/src/cli.ts stop",
    "dashboard:restart": "tsx packages/dashboard/src/cli.ts restart",
    "dashboard:status": "tsx packages/dashboard/src/cli.ts status"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.8"
  }
}
