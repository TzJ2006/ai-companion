import { describe, it, expect } from 'vitest';
import type { OnboardRenderOptions } from '../../packages/render/src/onboard-renderer.js';
import { renderOnboardHtml } from '../../packages/render/src/onboard-renderer.js';
import type { ProjectIndex } from '@aidev/history';
import type { ParsedModule } from '@aidev/ast';

function makeIdx(): ProjectIndex {
  return { function_index: {}, last_updated: '2026-01-01' } as ProjectIndex;
}

function makeMod(): ParsedModule {
  return { file_path: 'src/test.ts', functions: [], classes: [], imports: [] };
}

describe('renderOnboardHtml', () => {
  it('should execute without throwing', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    expect(() => renderOnboardHtml(idx, opts)).not.toThrow();
  });

  it('should return string', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(typeof res).toBe('string');
  });

  it('should have DOCTYPE', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toMatch(/^<!DOCTYPE html>/);
  });

  it('should have html close', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res.trim()).toMatch(/<\/html>$/);
  });

  it('should have title', () => {    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('Project Onboarding Report');
  });

  it('should use custom title', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [], title: 'Test' };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('Test');
  });

  it('should escape title', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [], title: '<x>' };
    const res = renderOnboardHtml(idx, opts);
    expect(res).not.toContain('<x>');
    expect(res).toContain('&lt;x&gt;');
  });

  it('should have head', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('<head>');
  });

  it('should have body', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('<body>');
  });

  it('should have style', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('<style>');
  });

  it('should have CSS', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('--bg:');
  });

  it('should have overview', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('overview-panel');
  });

  it('should have File Breakdown', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('File Breakdown');
  });

  it('should have index', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('Function Index');
  });

  it('should have script', () => {
    const idx = makeIdx();
    const opts: OnboardRenderOptions = { project_root: '/p', modules: [] };
    const res = renderOnboardHtml(idx, opts);
    expect(res).toContain('<script>');
  });
});
